{
  "name": "painel-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Painel pessoal como app de computador (Electron + Vite + React), lendo a API da nuvem com login Google.",
  "main": "dist/main/main.cjs",
  "scripts": {
    "build:main": "node build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "dev": "pnpm build && electron .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run --root .",
    "dmg": "pnpm build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.2.6",
    "@fontsource/inter-tight": "5.2.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.7.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "43.7.7",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "lucide-react": "0.544.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "recharts": "2.15.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@9.15.4",
  "build": {
    "appId": "br.themacedo.painel",
    "productName": "Painel",
    "copyright": "themacedo",
    "afterPack": "./build/assinar-adhoc.cjs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "LSUIElement": false,
        "NSUserNotificationAlertStyle": "alert"
      }
    },
    "dmg": {
      "title": "Painel",
      "artifactName": "Painel-${version}.dmg"
    }
  },
  "author": "themacedo"
}
